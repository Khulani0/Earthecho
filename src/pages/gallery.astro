---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import { resolveProductImage } from '../lib/productImages';
import { business, whatsappLink } from '../config';

const items = (await getCollection('gallery'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((entry) => ({
    ...entry.data,
    asset: resolveProductImage(entry.data.image),
  }))
  .filter((i) => i.asset);
---

<BaseLayout
  title="Gallery"
  description="See Earthecho's handcrafted cement planters and garden features styled in real gardens and homes around Cape Town."
>
  <section class="gallery-head">
    <div class="container container-narrow">
      <p class="eyebrow">Styled &amp; planted</p>
      <h1>Gallery</h1>
      <p class="gallery-intro">
        Our handcrafted pieces at home in real gardens. Tap any photo to view it
        larger.
      </p>
    </div>
  </section>

  <section class="section gallery-section">
    <div class="container">
      <div class="masonry">
        {
          items.map((item, i) => (
            <button
              class="masonry-item"
              data-full={item.asset!.src}
              data-caption={item.caption}
              aria-label={`View photo ${i + 1} larger`}
            >
              <Image
                src={item.asset!}
                alt={item.caption || `Earthecho garden photo ${i + 1}`}
                widths={[400, 800]}
                sizes="(max-width: 700px) 100vw, 380px"
                loading={i < 4 ? 'eager' : 'lazy'}
              />
            </button>
          ))
        }
      </div>

      <div class="gallery-cta">
        <p>Ready to bring a piece home?</p>
        <div class="gallery-actions">
          <a class="btn btn-primary" href="/shop">Shop the collection</a>
          <a class="btn btn-outline" href={whatsappLink()}>Ask on WhatsApp</a>
        </div>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="lightbox" id="lightbox" hidden>
    <button class="lightbox-close" id="lightbox-close" aria-label="Close">×</button>
    <figure class="lightbox-figure">
      <img id="lightbox-img" src="" alt="" />
      <figcaption id="lightbox-cap"></figcaption>
    </figure>
  </div>
</BaseLayout>

<script>
  const lb = document.getElementById('lightbox')!;
  const lbImg = document.getElementById('lightbox-img') as HTMLImageElement;
  const lbCap = document.getElementById('lightbox-cap')!;
  const closeBtn = document.getElementById('lightbox-close')!;

  function open(full: string, caption: string) {
    lbImg.src = full;
    lbImg.alt = caption || 'Earthecho garden photo';
    lbCap.textContent = caption || '';
    lb.hidden = false;
    document.body.style.overflow = 'hidden';
  }
  function close() {
    lb.hidden = true;
    lbImg.src = '';
    document.body.style.overflow = '';
  }

  document.querySelectorAll<HTMLButtonElement>('.masonry-item').forEach((btn) => {
    btn.addEventListener('click', () =>
      open(btn.dataset.full ?? '', btn.dataset.caption ?? ''),
    );
  });
  closeBtn.addEventListener('click', close);
  lb.addEventListener('click', (e) => {
    if (e.target === lb) close();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && !lb.hidden) close();
  });
</script>

<style>
  .gallery-head {
    padding-block: clamp(3.5rem, 8vw, 6rem) var(--space-4);
    text-align: center;
  }
  .gallery-intro {
    color: var(--text-muted);
    font-size: var(--text-lg);
    max-width: 48ch;
    margin-inline: auto;
  }
  .gallery-section {
    padding-top: var(--space-8);
  }
  .masonry {
    column-count: 3;
    column-gap: var(--space-6);
  }
  .masonry-item {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 var(--space-6);
    border: none;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
    border-radius: var(--radius);
    overflow: hidden;
    line-height: 0;
  }
  .masonry-item :global(img) {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .masonry-item:hover :global(img) {
    transform: scale(1.04);
  }
  @media (max-width: 900px) {
    .masonry {
      column-count: 2;
    }
  }
  @media (max-width: 540px) {
    .masonry {
      column-count: 1;
    }
  }

  .gallery-cta {
    text-align: center;
    margin-top: var(--space-16);
  }
  .gallery-actions {
    display: flex;
    gap: var(--space-4);
    justify-content: center;
    flex-wrap: wrap;
    margin-top: var(--space-4);
  }

  .lightbox {
    position: fixed;
    inset: 0;
    z-index: 100;
    background: rgba(20, 22, 18, 0.9);
    display: grid;
    place-items: center;
    padding: var(--space-6);
  }
  .lightbox[hidden] {
    display: none;
  }
  .lightbox-figure {
    margin: 0;
    max-width: min(900px, 92vw);
    max-height: 88vh;
    text-align: center;
  }
  .lightbox-figure img {
    max-width: 100%;
    max-height: 78vh;
    border-radius: var(--radius);
    object-fit: contain;
  }
  .lightbox-figure figcaption {
    color: rgba(255, 255, 255, 0.85);
    font-size: var(--text-sm);
    margin-top: var(--space-3);
  }
  .lightbox-close {
    position: fixed;
    top: 16px;
    right: 22px;
    background: none;
    border: none;
    color: #fff;
    font-size: 2.4rem;
    line-height: 1;
    cursor: pointer;
  }
</style>
