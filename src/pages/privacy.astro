---
import BaseLayout from '../layouts/BaseLayout.astro';
import { business } from '../config';
---

<BaseLayout
  title="Privacy"
  description="How Earthecho Designs handles your personal information under POPIA."
>
  <section class="section">
    <div class="container container-narrow prose">
      <h1>Privacy notice</h1>
      <p>
        {business.name} respects your privacy. In line with South Africa's
        Protection of Personal Information Act (POPIA), we collect only the
        information needed to fulfil an order — your name, contact number, and a
        delivery address if you choose delivery.
      </p>
      <p>
        Orders are sent to us over WhatsApp. We do not run third-party trackers
        or advertising cookies on this site. We do not sell or share your
        information.
      </p>
      <h2>Cookies &amp; storage</h2>
      <p>
        This site uses only <strong>essential local storage</strong> in your
        browser — to remember the items in your cart and your delivery choice.
        This information stays on your device, is not sent to any advertising
        network, and is not used to track you. If you submit the enquiry form,
        it is delivered to us by a form service purely so we can reply.
      </p>
      <p>
        Questions? Email
        <a href={`mailto:${business.email}`}>{business.email}</a>.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .prose p {
    max-width: 65ch;
  }
</style>
