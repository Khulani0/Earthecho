---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Shop"
  description="Browse handcrafted cement planters and garden features by Earthecho Designs."
>
  <section class="section">
    <div class="container">
      <h1>Shop</h1>
      <p class="lead">
        The full collection is being loaded in the next build phase. Soon you'll
        browse all 22 handcrafted pieces here, filter by category and sort by
        price.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-muted);
    max-width: 60ch;
    font-size: var(--text-lg);
  }
</style>
