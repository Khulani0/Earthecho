---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryShowcase from '../components/CategoryShowcase.astro';
import { business, contacts, whatsappLink } from '../config';

const all = await getCollection('products');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 4);
---

<BaseLayout title={business.name} description={business.framing}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Handcrafted in Cape Town</p>
      <h1>{business.tagline}</h1>
      <p class="hero-framing">{business.framing}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/shop">Shop the collection</a>
        <a class="btn btn-outline" href={whatsappLink()}>Order on WhatsApp</a>
      </div>
    </div>
  </section>

  <!-- Trust badges -->
  <section class="section trust-section">
    <div class="container">
      <TrustBadges />
    </div>
  </section>

  <!-- Shop by category -->
  <CategoryShowcase />

  <!-- Featured products -->
  <section class="section featured-section">
    <div class="container">
      <h2 class="section-title">Featured pieces</h2>
      <div class="product-grid">
        {featured.map((product) => <ProductCard product={product} loading="eager" />)}
      </div>
      <div class="featured-cta">
        <a class="btn btn-outline" href="/shop">View the full collection</a>
      </div>
    </div>
  </section>

  <!-- Story -->
  <section class="section story">
    <div class="container container-narrow story-inner">
      <p class="eyebrow">Our craft</p>
      <h2>Handcrafted, one piece at a time</h2>
      <p>
        Every Earthecho planter and garden feature is cast by hand in {
          business.location
        }. We work in durable cement built for South African weather — pieces
        made to live indoors or out, with drainage holes included and no two
        exactly alike.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href={whatsappLink()}>WhatsApp us</a>
        <a
          class="btn btn-outline"
          href={`tel:+${contacts.whatsappNumber}`}>Call {contacts.ordersPhoneDisplay}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(
        110% 90% at 50% -20%,
        var(--surface-subtle),
        transparent 70%
      ),
      var(--surface);
    padding-block: var(--space-24) var(--space-16);
    text-align: center;
  }
  .hero-inner {
    max-width: 760px;
  }
  .hero-framing {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 620px;
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-8);
  }
  .trust-section {
    padding-block: var(--space-8);
    border-block: 1px solid var(--border-soft);
    background: var(--surface);
  }
  .section-title {
    text-align: center;
    margin-bottom: var(--space-12);
  }
  .featured-cta {
    text-align: center;
    margin-top: var(--space-12);
  }
  .story {
    background: var(--surface-subtle);
  }
  .story-inner {
    text-align: center;
  }
</style>
