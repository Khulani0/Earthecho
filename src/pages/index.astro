---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import ProductCard from '../components/ProductCard.astro';
import CategoryShowcase from '../components/CategoryShowcase.astro';
import { business, contacts, whatsappLink } from '../config';

const all = await getCollection('products');
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout title={business.name} description={business.framing}>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Handcrafted in Cape Town</p>
      <h1 class="hero-title">{business.tagline}</h1>
      <p class="hero-framing">{business.framing}</p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/shop">Shop the collection</a>
      </div>
      <a class="hero-link" href={whatsappLink()}>or order on WhatsApp →</a>
    </div>
  </section>

  <!-- Shop by category -->
  <CategoryShowcase />

  <!-- Featured products -->
  <section class="section">
    <div class="container">
      <p class="eyebrow section-eyebrow">Selected pieces</p>
      <h2 class="section-title">Featured</h2>
      <div class="product-grid">
        {featured.map((product) => <ProductCard product={product} loading="eager" />)}
      </div>
      <div class="featured-cta">
        <a class="btn btn-outline" href="/shop">View all 22 pieces</a>
      </div>
    </div>
  </section>

  <!-- Trust strip -->
  <section class="trust-strip">
    <div class="container">
      <TrustBadges />
    </div>
  </section>

  <!-- Story -->
  <section class="section story">
    <div class="container container-narrow story-inner">
      <p class="eyebrow">Our craft</p>
      <h2>Handcrafted, one piece at a time</h2>
      <p>
        Every Earthecho planter and garden feature is cast by hand in {
          business.location
        }. We work in durable cement built for South African weather — pieces
        made to live indoors or out, with drainage holes included and no two
        exactly alike.
      </p>
      <div class="hero-actions story-actions">
        <a class="btn btn-primary" href={whatsappLink()}>WhatsApp us</a>
        <a class="btn btn-outline" href={`tel:+${contacts.whatsappNumber}`}
          >Call {contacts.ordersPhoneDisplay}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(110% 90% at 50% -20%, var(--surface-subtle), transparent 70%),
      var(--surface);
    padding-block: clamp(5rem, 12vw, 9rem);
    text-align: center;
  }
  .hero-inner {
    max-width: 820px;
  }
  .hero-title {
    font-weight: 400;
    font-size: clamp(2.6rem, 7vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    margin-bottom: var(--space-6);
  }
  .hero-framing {
    font-size: var(--text-lg);
    color: var(--text-muted);
    max-width: 560px;
    margin-inline: auto;
  }
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    justify-content: center;
    margin-top: var(--space-8);
  }
  .hero-link {
    display: inline-block;
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }
  .hero-link:hover {
    color: var(--color-botanical);
  }

  .section-eyebrow {
    display: block;
    text-align: center;
  }
  .section-title {
    text-align: center;
    font-weight: 400;
    margin: var(--space-2) 0 var(--space-12);
  }
  .featured-cta {
    text-align: center;
    margin-top: var(--space-12);
  }

  .trust-strip {
    padding-block: var(--space-8);
    border-block: 1px solid var(--border-soft);
    background: var(--surface);
  }

  .story {
    background: var(--surface-subtle);
    text-align: center;
  }
  .story-actions {
    margin-top: var(--space-6);
  }
</style>
