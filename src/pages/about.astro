---
import BaseLayout from '../layouts/BaseLayout.astro';
import TrustBadges from '../components/TrustBadges.astro';
import LocalBusinessSchema from '../components/LocalBusinessSchema.astro';
import { business } from '../config';
---

<BaseLayout
  title="About"
  description="Earthecho Designs handcrafts durable concrete planters and garden features in Pretoria, South Africa."
>
  <LocalBusinessSchema slot="head" />
  <section class="section">
    <div class="container container-narrow">
      <p class="eyebrow">Our story</p>
      <h1>Handcrafted in {business.location}</h1>
      <p>
        Earthecho Designs is a small {business.location} studio making concrete
        planters and garden features by hand. This page will carry the full
        story, the team and our workshop details — arriving soon.
      </p>
      <TrustBadges />
    </div>
  </section>
</BaseLayout>
