---
import BaseLayout from '../layouts/BaseLayout.astro';
import { deliveryOptions, contacts, business } from '../config';
import { eft, hasEft } from '../lib/eft';
---

<BaseLayout
  title="Checkout"
  description="Complete your Earthecho order — we finalise delivery and payment with you on WhatsApp."
>
  <section class="section">
    <div class="container container-narrow">
      <!-- ===== Checkout form ===== -->
      <div id="checkout-view">
        <h1>Checkout</h1>
        <p class="lead">
          Fill in your details and we'll send your order straight to us on
          WhatsApp. We confirm delivery and payment with you before anything is
          finalised — no card payment is taken on this site.
        </p>

        <div class="review" id="order-review"><!-- rendered by JS --></div>

        <form id="checkout-form" novalidate>
          <div class="field">
            <label for="name">Your name *</label>
            <input id="name" name="name" type="text" required autocomplete="name" />
          </div>

          <div class="field">
            <label for="phone">Phone number *</label>
            <input
              id="phone"
              name="phone"
              type="tel"
              required
              autocomplete="tel"
              inputmode="tel"
              placeholder="e.g. 082 123 4567"
            />
          </div>

          <div class="field">
            <label for="email">Email <span class="opt">(optional)</span></label>
            <input id="email" name="email" type="email" autocomplete="email" />
          </div>

          <fieldset class="field delivery">
            <legend>Delivery *</legend>
            {
              deliveryOptions.map((opt, i) => (
                <label class="delivery-opt">
                  <input
                    type="radio"
                    name="delivery"
                    value={opt.id}
                    data-needs-address={String(opt.needsAddress)}
                    checked={i === 0}
                  />
                  <span>
                    <span class="delivery-label">{opt.label}</span>
                    <span class="delivery-note">{opt.note}</span>
                  </span>
                </label>
              ))
            }
          </fieldset>

          <div class="field" id="address-field" hidden>
            <label for="address">Delivery address *</label>
            <textarea
              id="address"
              name="address"
              rows="3"
              placeholder="Street, suburb, city, postal code"></textarea>
          </div>

          <p class="err" id="form-error" hidden></p>

          <button type="submit" class="btn btn-primary btn-block">
            Send order on WhatsApp
          </button>
          <a class="btn btn-outline btn-block" href="/cart">Back to cart</a>
          <p class="fineprint">
            Prices in ZAR. No VAT charged. By sending you agree we may contact
            you about this order.
          </p>
        </form>
      </div>

      <!-- ===== Confirmation (revealed after order) ===== -->
      <div id="confirm-view" hidden>
        <div class="confirm-card">
          <span class="confirm-tick" aria-hidden="true">✓</span>
          <h1>Order sent!</h1>
          <p>
            Your WhatsApp should have opened with the order ready to send. If it
            didn't, tap the button below.
          </p>
          <p class="order-ref">
            Order reference: <strong id="order-ref"></strong>
          </p>

          <a
            class="btn btn-primary btn-block"
            id="wa-fallback"
            href="#"
            target="_blank"
            rel="noopener">Open WhatsApp to send your order</a
          >

          <div class="next-steps">
            <h2>What happens next</h2>
            <ol>
              <li>
                We reply on WhatsApp to confirm stock, delivery and the final
                total (including any courier quote).
              </li>
              <li>Once confirmed, you pay by EFT using the details below.</li>
              <li>We arrange collection or delivery of your pieces.</li>
            </ol>
          </div>

          <div class="eft">
            <h2>Payment (EFT)</h2>
            {
              hasEft ? (
                <dl class="eft-details">
                  <div>
                    <dt>Bank</dt>
                    <dd>{eft.bank}</dd>
                  </div>
                  <div>
                    <dt>Account name</dt>
                    <dd>{eft.accountName ?? business.name}</dd>
                  </div>
                  <div>
                    <dt>Account number</dt>
                    <dd>{eft.accountNumber}</dd>
                  </div>
                  <div>
                    <dt>Branch code</dt>
                    <dd>{eft.branchCode}</dd>
                  </div>
                  <div>
                    <dt>Reference</dt>
                    <dd><span id="eft-ref" /></dd>
                  </div>
                </dl>
              ) : (
                <p class="eft-fallback">
                  We'll send our EFT banking details to you on WhatsApp when we
                  confirm your order.
                </p>
              )
            }
            <p class="eft-note">
              Please only pay once we've confirmed your order and the final
              total. Use your order reference as the payment reference.
            </p>
          </div>

          <a class="btn btn-outline btn-block" href="/shop" id="new-order"
            >Start a new order</a
          >
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    getCart,
    subtotal,
    clearCart,
    type CartItem,
  } from '../scripts/cart';
  import { deliveryOptions, contacts } from '../config';

  const DELIVERY_KEY = 'earthecho_delivery_v1';
  const rand = (n: number) => `R${n.toLocaleString('en-ZA')}`;

  const checkoutView = document.getElementById('checkout-view')!;
  const confirmView = document.getElementById('confirm-view')!;
  const reviewEl = document.getElementById('order-review')!;
  const form = document.getElementById('checkout-form') as HTMLFormElement;
  const errorEl = document.getElementById('form-error')!;
  const addressField = document.getElementById('address-field')!;
  const addressInput = document.getElementById('address') as HTMLTextAreaElement;

  function currentDelivery() {
    const val =
      document.querySelector<HTMLInputElement>('input[name="delivery"]:checked')
        ?.value ?? 'collection';
    return deliveryOptions.find((o) => o.id === val)!;
  }

  // --- Render order review; bounce to shop if cart empty ---
  function renderReview() {
    const cart = getCart();
    if (cart.length === 0) {
      reviewEl.innerHTML = `<p class="empty">Your cart is empty. <a href="/shop">Browse the collection</a>.</p>`;
      form.hidden = true;
      return;
    }
    const rows = cart
      .map(
        (i) =>
          `<div class="rev-row"><span>${i.qty} × ${i.name}</span><span>${rand(
            i.price * i.qty,
          )}</span></div>`,
      )
      .join('');
    reviewEl.innerHTML = `
      <h2 class="rev-title">Your order</h2>
      ${rows}
      <div class="rev-row rev-sub"><span>Subtotal</span><span>${rand(subtotal())}</span></div>`;
  }

  // --- Restore saved delivery choice & toggle address ---
  const saved = localStorage.getItem(DELIVERY_KEY);
  if (saved) {
    const radio = document.querySelector<HTMLInputElement>(
      `input[name="delivery"][value="${saved}"]`,
    );
    if (radio) radio.checked = true;
  }
  function toggleAddress() {
    const needs = currentDelivery().needsAddress;
    addressField.hidden = !needs;
    addressInput.required = needs;
  }
  document
    .querySelectorAll<HTMLInputElement>('input[name="delivery"]')
    .forEach((r) =>
      r.addEventListener('change', () => {
        localStorage.setItem(DELIVERY_KEY, currentDelivery().id);
        toggleAddress();
      }),
    );

  // --- Order reference: EE-YYMMDD-XXXX ---
  function makeRef() {
    const d = new Date();
    const y = String(d.getFullYear()).slice(2);
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    const rnd = Math.floor(1000 + Math.random() * 9000);
    return `EE-${y}${m}${day}-${rnd}`;
  }

  function buildMessage(
    cart: CartItem[],
    ref: string,
    name: string,
    phone: string,
    email: string,
    address: string,
  ) {
    const opt = currentDelivery();
    const lines = cart.map(
      (i) => `• ${i.qty} × ${i.name} (${i.code}) @ ${rand(i.price)} = ${rand(i.price * i.qty)}`,
    );
    const sub = subtotal();
    const deliveryLine =
      opt.fee === null
        ? `${opt.label} (quote on request)`
        : opt.fee === 0
          ? `${opt.label} (Free)`
          : `${opt.label} (${rand(opt.fee)})`;
    const total =
      opt.fee === null
        ? `${rand(sub)} + delivery quote`
        : rand(sub + opt.fee);

    let msg = `New order — Earthecho Designs\nRef: ${ref}\n\n`;
    msg += lines.join('\n');
    msg += `\n\nSubtotal: ${rand(sub)}\nDelivery: ${deliveryLine}\nTotal: ${total}\n\n`;
    msg += `Name: ${name}\nPhone: ${phone}`;
    if (email) msg += `\nEmail: ${email}`;
    if (opt.needsAddress && address) msg += `\nAddress: ${address}`;
    return msg;
  }

  // --- Submit ---
  form.addEventListener('submit', (e) => {
    e.preventDefault();
    errorEl.hidden = true;
    const cart = getCart();
    if (cart.length === 0) return;

    const name = (form.elements.namedItem('name') as HTMLInputElement).value.trim();
    const phone = (form.elements.namedItem('phone') as HTMLInputElement).value.trim();
    const email = (form.elements.namedItem('email') as HTMLInputElement).value.trim();
    const address = addressInput.value.trim();
    const opt = currentDelivery();

    if (!name || !phone) {
      showError('Please enter your name and phone number.');
      return;
    }
    if (opt.needsAddress && !address) {
      showError('Please add a delivery address for this delivery option.');
      return;
    }

    const ref = makeRef();
    const message = buildMessage(cart, ref, name, phone, email, address);
    const waUrl = `https://wa.me/${contacts.whatsappNumber}?text=${encodeURIComponent(message)}`;

    // Open WhatsApp
    window.open(waUrl, '_blank', 'noopener');

    // Confirmation screen
    document.getElementById('order-ref')!.textContent = ref;
    const eftRef = document.getElementById('eft-ref');
    if (eftRef) eftRef.textContent = ref;
    (document.getElementById('wa-fallback') as HTMLAnchorElement).href = waUrl;

    clearCart();
    checkoutView.hidden = true;
    confirmView.hidden = false;
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  function showError(msg: string) {
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  document.getElementById('new-order')?.addEventListener('click', clearCart);

  renderReview();
  toggleAddress();
</script>

<style>
  .lead {
    color: var(--text-muted);
    max-width: 60ch;
  }
  .review {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: var(--space-4) var(--space-6);
    margin: var(--space-6) 0;
  }
  :global(.rev-title) {
    font-size: var(--text-lg);
    margin-bottom: var(--space-3);
  }
  :global(.rev-row) {
    display: flex;
    justify-content: space-between;
    padding: var(--space-2) 0;
    font-size: var(--text-sm);
  }
  :global(.rev-sub) {
    border-top: 1px solid var(--border-soft);
    margin-top: var(--space-2);
    font-weight: 700;
    color: var(--color-botanical);
  }
  .field {
    margin-bottom: var(--space-4);
  }
  .field label,
  .field legend {
    display: block;
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .opt {
    font-weight: 400;
    color: var(--text-muted);
    font-size: var(--text-sm);
  }
  .field input,
  .field textarea {
    width: 100%;
    padding: 0.7rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    font-family: var(--font-sans);
    font-size: var(--text-base);
    background: var(--surface);
    color: var(--text);
  }
  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--color-botanical);
    outline-offset: 1px;
    border-color: var(--color-botanical);
  }
  .delivery {
    border: none;
    padding: 0;
  }
  .delivery-opt {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
    cursor: pointer;
  }
  .delivery-opt:has(input:checked) {
    border-color: var(--color-botanical);
    background: color-mix(in srgb, var(--color-botanical) 5%, transparent);
  }
  .delivery-label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .delivery-note {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .err {
    color: var(--accent);
    font-weight: 600;
    background: color-mix(in srgb, var(--accent) 10%, transparent);
    padding: var(--space-3);
    border-radius: var(--radius-sm);
  }
  .btn-block {
    display: flex;
    width: 100%;
    margin-top: var(--space-3);
  }
  .fineprint {
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: var(--space-4);
    text-align: center;
  }

  /* Confirmation */
  .confirm-card {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    padding: var(--space-12) var(--space-8);
    text-align: center;
  }
  .confirm-tick {
    display: grid;
    place-items: center;
    width: 60px;
    height: 60px;
    margin: 0 auto var(--space-4);
    border-radius: 50%;
    background: var(--color-botanical);
    color: var(--color-white);
    font-size: 1.8rem;
  }
  .order-ref {
    font-size: var(--text-lg);
  }
  .next-steps,
  .eft {
    text-align: left;
    margin-top: var(--space-8);
    padding-top: var(--space-6);
    border-top: 1px solid var(--border-soft);
  }
  .next-steps h2,
  .eft h2 {
    font-size: var(--text-lg);
  }
  .next-steps ol {
    padding-left: 1.2rem;
    color: var(--text);
  }
  .next-steps li {
    margin-bottom: var(--space-2);
  }
  .eft-details {
    display: grid;
    gap: var(--space-2);
    background: var(--color-paper);
    border-radius: var(--radius-sm);
    padding: var(--space-4);
  }
  .eft-details div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
  }
  .eft-details dt {
    color: var(--text-muted);
    margin: 0;
  }
  .eft-details dd {
    margin: 0;
    font-weight: 600;
    text-align: right;
  }
  .eft-note {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin-top: var(--space-3);
  }
</style>
