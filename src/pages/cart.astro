---
import BaseLayout from '../layouts/BaseLayout.astro';
import { deliveryOptions } from '../config';
---

<BaseLayout
  title="Cart"
  description="Review your Earthecho pieces and choose a delivery option before checkout."
>
  <section class="section">
    <div class="container">
      <h1>Your cart</h1>

      <!-- Empty state -->
      <div class="cart-empty" id="cart-empty" hidden>
        <p>Your cart is empty.</p>
        <a class="btn btn-primary" href="/shop">Browse the collection</a>
      </div>

      <!-- Cart with items -->
      <div class="cart-layout" id="cart-layout" hidden>
        <div class="cart-items" id="cart-items"><!-- rendered by JS --></div>

        <aside class="cart-summary">
          <h2 class="summary-title">Order summary</h2>

          <fieldset class="delivery">
            <legend>Delivery</legend>
            {
              deliveryOptions.map((opt, i) => (
                <label class="delivery-opt">
                  <input
                    type="radio"
                    name="delivery"
                    value={opt.id}
                    data-fee={opt.fee ?? ''}
                    checked={i === 0}
                  />
                  <span class="delivery-body">
                    <span class="delivery-label">
                      {opt.label}
                      <span class="delivery-fee" data-fee-for={opt.id} />
                    </span>
                    <span class="delivery-note">{opt.note}</span>
                  </span>
                </label>
              ))
            }
          </fieldset>

          <dl class="totals">
            <div>
              <dt>Subtotal</dt>
              <dd id="sum-subtotal">R0</dd>
            </div>
            <div>
              <dt>Delivery</dt>
              <dd id="sum-delivery">Free</dd>
            </div>
            <div class="grand">
              <dt>Total</dt>
              <dd id="sum-total">R0</dd>
            </div>
          </dl>

          <p class="vat-note">Prices in ZAR. No VAT charged.</p>
          <a class="btn btn-primary btn-block" href="/checkout" id="checkout-btn"
            >Checkout</a
          >
          <a class="btn btn-outline btn-block" href="/shop">Keep shopping</a>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  import {
    getCart,
    updateQty,
    removeItem,
    subtotal,
    onCartChange,
  } from '../scripts/cart';
  import { deliveryOptions } from '../config';

  const DELIVERY_KEY = 'earthecho_delivery_v1';
  const rand = (n: number) => `R${n.toLocaleString('en-ZA')}`;

  const emptyEl = document.getElementById('cart-empty')!;
  const layoutEl = document.getElementById('cart-layout')!;
  const itemsEl = document.getElementById('cart-items')!;

  function selectedDelivery(): string {
    const checked = document.querySelector<HTMLInputElement>(
      'input[name="delivery"]:checked',
    );
    return checked?.value ?? 'collection';
  }

  function renderItems() {
    const cart = getCart();
    emptyEl.hidden = cart.length > 0;
    layoutEl.hidden = cart.length === 0;
    if (cart.length === 0) return;

    itemsEl.innerHTML = cart
      .map(
        (item) => `
      <div class="line" data-code="${item.code}">
        <div class="line-info">
          <span class="line-name">${item.name}</span>
          <span class="line-code">${item.code} · ${rand(item.price)} each</span>
        </div>
        <div class="line-controls">
          <div class="qty">
            <button class="qty-btn" data-act="dec" aria-label="Decrease quantity">−</button>
            <input class="qty-val" type="number" min="1" value="${item.qty}" aria-label="Quantity" />
            <button class="qty-btn" data-act="inc" aria-label="Increase quantity">+</button>
          </div>
          <span class="line-total">${rand(item.price * item.qty)}</span>
          <button class="remove" data-act="remove" aria-label="Remove ${item.name}">Remove</button>
        </div>
      </div>`,
      )
      .join('');
  }

  function renderTotals() {
    const sub = subtotal();
    const opt = deliveryOptions.find((o) => o.id === selectedDelivery());
    const fee = opt?.fee ?? null;

    (document.getElementById('sum-subtotal')!).textContent = rand(sub);

    const deliveryEl = document.getElementById('sum-delivery')!;
    const totalEl = document.getElementById('sum-total')!;
    if (fee === null) {
      deliveryEl.textContent = 'Quote on request';
      totalEl.textContent = `${rand(sub)} + delivery`;
    } else {
      deliveryEl.textContent = fee === 0 ? 'Free' : rand(fee);
      totalEl.textContent = rand(sub + fee);
    }

    // Per-option fee labels
    deliveryOptions.forEach((o) => {
      const el = document.querySelector<HTMLElement>(`[data-fee-for="${o.id}"]`);
      if (el)
        el.textContent =
          o.fee === null ? '' : o.fee === 0 ? ' · Free' : ` · ${rand(o.fee)}`;
    });
  }

  function render() {
    renderItems();
    renderTotals();
  }

  // Item interactions (event delegation)
  itemsEl.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const line = btn.closest<HTMLElement>('.line');
    const code = line?.dataset.code;
    if (!code) return;
    const input = line!.querySelector<HTMLInputElement>('.qty-val')!;
    const current = Number(input.value) || 1;
    const act = btn.dataset.act;
    if (act === 'inc') updateQty(code, current + 1);
    else if (act === 'dec') updateQty(code, current - 1);
    else if (act === 'remove') removeItem(code);
  });
  itemsEl.addEventListener('change', (e) => {
    const input = (e.target as HTMLElement).closest<HTMLInputElement>('.qty-val');
    if (!input) return;
    const code = input.closest<HTMLElement>('.line')?.dataset.code;
    if (code) updateQty(code, Math.max(1, Number(input.value) || 1));
  });

  // Delivery selection persists for checkout
  document.querySelectorAll<HTMLInputElement>('input[name="delivery"]').forEach(
    (radio) =>
      radio.addEventListener('change', () => {
        localStorage.setItem(DELIVERY_KEY, selectedDelivery());
        renderTotals();
      }),
  );

  // Restore saved delivery choice
  const saved = localStorage.getItem(DELIVERY_KEY);
  if (saved) {
    const radio = document.querySelector<HTMLInputElement>(
      `input[name="delivery"][value="${saved}"]`,
    );
    if (radio) radio.checked = true;
  }

  onCartChange(render);
  render();
</script>

<style>
  .cart-empty {
    text-align: center;
    padding: var(--space-16) 0;
    color: var(--text-muted);
  }
  .cart-empty .btn {
    margin-top: var(--space-4);
  }
  .cart-layout {
    display: grid;
    grid-template-columns: 1fr 340px;
    gap: var(--space-8);
    align-items: start;
    margin-top: var(--space-6);
  }
  .cart-items {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  :global(.line) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    flex-wrap: wrap;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: var(--space-4);
  }
  :global(.line-name) {
    display: block;
    font-weight: 600;
    font-family: var(--font-serif);
    font-size: var(--text-lg);
    color: var(--color-botanical);
  }
  :global(.line-code) {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  :global(.line-controls) {
    display: flex;
    align-items: center;
    gap: var(--space-4);
  }
  :global(.qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    overflow: hidden;
  }
  :global(.qty-btn) {
    width: 32px;
    height: 34px;
    border: none;
    background: var(--color-paper);
    cursor: pointer;
    font-size: 1.1rem;
    color: var(--color-botanical);
  }
  :global(.qty-btn:hover) {
    background: var(--border-soft);
  }
  :global(.qty-val) {
    width: 46px;
    height: 34px;
    border: none;
    border-inline: 1px solid var(--border);
    text-align: center;
    font-size: var(--text-base);
    -moz-appearance: textfield;
  }
  :global(.qty-val::-webkit-outer-spin-button),
  :global(.qty-val::-webkit-inner-spin-button) {
    -webkit-appearance: none;
    margin: 0;
  }
  :global(.line-total) {
    font-weight: 700;
    color: var(--color-botanical);
    min-width: 70px;
    text-align: right;
  }
  :global(.remove) {
    background: none;
    border: none;
    color: var(--text-muted);
    cursor: pointer;
    font-size: var(--text-sm);
    text-decoration: underline;
  }
  :global(.remove:hover) {
    color: var(--accent);
  }
  .cart-summary {
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    padding: var(--space-6);
    position: sticky;
    top: calc(var(--header-height) + var(--space-4));
  }
  .summary-title {
    font-size: var(--text-xl);
    margin-bottom: var(--space-4);
  }
  .delivery {
    border: none;
    padding: 0;
    margin: 0 0 var(--space-4);
  }
  .delivery legend {
    font-weight: 600;
    margin-bottom: var(--space-2);
  }
  .delivery-opt {
    display: flex;
    gap: var(--space-3);
    padding: var(--space-3);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-sm);
    margin-bottom: var(--space-2);
    cursor: pointer;
  }
  .delivery-opt:has(input:checked) {
    border-color: var(--color-botanical);
    background: color-mix(in srgb, var(--color-botanical) 5%, transparent);
  }
  .delivery-opt input {
    margin-top: 0.25rem;
  }
  .delivery-label {
    display: block;
    font-weight: 600;
    font-size: var(--text-sm);
  }
  .delivery-fee {
    color: var(--color-botanical);
  }
  .delivery-note {
    display: block;
    font-size: var(--text-xs);
    color: var(--text-muted);
    margin-top: 0.15rem;
  }
  .totals {
    margin: var(--space-4) 0;
    border-top: 1px solid var(--border-soft);
    padding-top: var(--space-4);
  }
  .totals div {
    display: flex;
    justify-content: space-between;
    margin-bottom: var(--space-2);
  }
  .totals dt,
  .totals dd {
    margin: 0;
  }
  .totals .grand {
    font-weight: 700;
    font-size: var(--text-lg);
    color: var(--color-botanical);
    border-top: 1px solid var(--border-soft);
    padding-top: var(--space-3);
    margin-top: var(--space-2);
  }
  .vat-note {
    font-size: var(--text-xs);
    color: var(--text-muted);
  }
  .btn-block {
    display: flex;
    width: 100%;
    margin-top: var(--space-2);
  }
  @media (max-width: 820px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }
    .cart-summary {
      position: static;
    }
  }
</style>
