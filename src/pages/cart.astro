---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Cart" description="Your Earthecho cart.">
  <section class="section">
    <div class="container container-narrow">
      <h1>Your cart</h1>
      <p class="lead">
        The cart and WhatsApp checkout are built in the next phases. Once live,
        you'll review your pieces here and send the order straight to us on
        WhatsApp.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .lead {
    color: var(--text-muted);
    font-size: var(--text-lg);
  }
</style>
