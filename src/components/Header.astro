---
import { business } from '../config';

const nav = [
  { label: 'Home', href: '/' },
  { label: 'Range', href: '/shop' },
  { label: 'Gallery', href: '/gallery' },
  { label: 'About', href: '/about' },
  { label: 'Contact', href: '/contact' },
];

const path = Astro.url.pathname;
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand" aria-label={`${business.name} — home`}>
      <span class="brand-mark" aria-hidden="true">◈</span>
      <span class="brand-name">Earthecho Designs</span>
    </a>

    <nav class="nav" aria-label="Primary">
      {
        nav.map((item) => (
          <a
            href={item.href}
            class:list={[
              'nav-link',
              {
                active:
                  item.href === '/'
                    ? path === '/'
                    : path.startsWith(item.href),
              },
            ]}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <a href="/cart" class="cart-link" aria-label="Cart">
      <svg
        width="22"
        height="22"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="9" cy="21" r="1"></circle>
        <circle cx="20" cy="21" r="1"></circle>
        <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"
        ></path>
      </svg>
      <span class="cart-count" data-cart-count hidden>0</span>
    </a>
  </div>
</header>

<script>
  import { count, onCartChange } from '../scripts/cart';

  const badge = document.querySelector<HTMLElement>('[data-cart-count]');
  function refresh() {
    if (!badge) return;
    const n = count();
    badge.textContent = String(n);
    badge.hidden = n === 0;
  }
  refresh();
  onCartChange(refresh);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, #ffffff 88%, transparent);
    backdrop-filter: saturate(150%) blur(10px);
    border-bottom: 1px solid var(--border-soft);
  }
  .header-inner {
    height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 600;
    color: var(--color-botanical);
  }
  .brand-mark {
    color: var(--accent);
    font-size: 1.1em;
  }
  .nav {
    display: flex;
    gap: var(--space-6);
    margin-inline: auto;
  }
  .nav-link {
    font-weight: 500;
    color: var(--text);
    padding-block: 0.25rem;
    border-bottom: 2px solid transparent;
  }
  .nav-link:hover,
  .nav-link.active {
    color: var(--color-botanical);
    border-bottom-color: var(--accent);
  }
  .cart-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    color: var(--color-botanical);
  }
  .cart-count {
    position: absolute;
    top: -8px;
    right: -10px;
    min-width: 18px;
    height: 18px;
    padding: 0 5px;
    border-radius: 999px;
    background: var(--accent);
    color: var(--color-white);
    font-size: 0.68rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }
  @media (max-width: 560px) {
    .nav {
      gap: var(--space-4);
      font-size: var(--text-sm);
    }
    .brand-name {
      display: none;
    }
  }
</style>
