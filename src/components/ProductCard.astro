---
import type { CollectionEntry } from 'astro:content';
import ProductImage from './ProductImage.astro';
import { formatPrice } from '../lib/format';

interface Props {
  product: CollectionEntry<'products'>;
  loading?: 'eager' | 'lazy';
}

const { product, loading = 'lazy' } = Astro.props;
const { data } = product;
---

<a
  href={`/products/${product.id}`}
  class="card"
  data-category={data.category}
  data-price={data.price}
  data-name={data.name}
>
  <div class="card-media">
    <ProductImage
      filename={data.image}
      alt={`${data.name} — handcrafted cement ${data.category.toLowerCase()} by Earthecho Designs`}
      loading={loading}
    />
    {!data.inStock && <span class="badge-oos">Sold out</span>}
  </div>
  <div class="card-body">
    <h3 class="card-name">{data.name}</h3>
    <p class="card-price">{formatPrice(data.price)}</p>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    background: transparent;
    color: var(--text);
  }
  .card:hover {
    color: var(--text);
  }
  .card-media {
    position: relative;
    aspect-ratio: 1 / 1;
    background: var(--surface);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .card-media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .card:hover .card-media {
    border-color: var(--border);
  }
  .card:hover .card-media :global(img) {
    transform: scale(1.045);
  }
  .badge-oos {
    position: absolute;
    top: var(--space-3);
    left: var(--space-3);
    background: var(--color-charcoal);
    color: var(--color-white);
    font-size: var(--text-xs);
    padding: 0.2rem 0.55rem;
    border-radius: 999px;
  }
  .card-body {
    padding: var(--space-4) var(--space-2) 0;
    text-align: center;
  }
  .card-name {
    font-family: var(--font-serif);
    font-size: var(--text-xl);
    font-weight: 400;
    line-height: 1.2;
    margin: 0 0 var(--space-2);
    color: var(--color-charcoal);
    transition: color 0.15s ease;
  }
  .card:hover .card-name {
    color: var(--color-botanical);
  }
  .card-price {
    margin: 0;
    font-weight: 500;
    color: var(--text-muted);
    font-size: var(--text-base);
    letter-spacing: 0.02em;
  }
</style>
