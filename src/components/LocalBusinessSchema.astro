---
import { business, contacts } from '../config';

// LocalBusiness structured data — powers local SEO (Google Maps, "cement
// planters Cape Town", the knowledge panel) and links the site to the
// business's Facebook + Google Business Profile via sameAs.
const schema = {
  '@context': 'https://schema.org',
  '@type': 'HomeGoodsStore',
  name: business.name,
  description: business.framing,
  image: new URL('/og-default.jpg', Astro.site).href,
  url: Astro.site?.href,
  telephone: `+${contacts.whatsappNumber}`,
  email: business.email,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Ottery',
    addressRegion: 'Western Cape',
    addressCountry: 'ZA',
  },
  areaServed: [
    { '@type': 'City', name: 'Cape Town' },
    { '@type': 'Country', name: 'South Africa' },
  ],
  openingHours: 'Mo-Sa 09:00-17:00',
  priceRange: 'R40–R749',
  sameAs: [business.facebookUrl, business.googleBusinessUrl],
};
---

<script
  type="application/ld+json"
  is:inline
  set:html={JSON.stringify(schema)}
/>
