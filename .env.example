# -------------------------------------------------------------------
# Earthecho Designs — environment variables
# Copy to `.env` for local builds, and set the same keys in Vercel
# (Project → Settings → Environment Variables). Never commit real values.
# -------------------------------------------------------------------

# Bank / EFT details — shown ONLY on the private order-confirmation screen,
# never on a public page. Used from Phase 3 onward.
EFT_BANK=Capitec
EFT_ACCOUNT_NUMBER=1053935080
EFT_BRANCH_CODE=450105
EFT_ACCOUNT_NAME=Earthecho Designs

# Contact enquiry form (added in Phase 5). Get a free form ID at formspree.io.
PUBLIC_FORMSPREE_ID=

# SEO & analytics (all optional — leave blank to disable).
# Google Search Console verification (HTML-tag method: paste just the content value).
PUBLIC_GSC_VERIFICATION=
# Cloudflare Web Analytics token — privacy-first, cookieless, free.
PUBLIC_CF_ANALYTICS_TOKEN=
